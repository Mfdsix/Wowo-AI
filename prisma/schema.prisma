generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Session {
  id          String         @id @default(cuid())
  title       String         @default("New Chat")
  designStyle String?        // NeedMCP style slug yang di-lock (e.g. "modern")
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  messages    Message[]
  designerPages DesignerPage[]
}

model Message {
  id         String   @id @default(cuid())
  sessionId  String
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role       String   // "user" | "assistant"
  content    String
  model      String?  // nama model yang dipake (optional)
  bookmarked Boolean  @default(false)
  replyToId  String?  // referensi pesan yang di-reply (quote)
  quoteText  String?  // teks spesifik yang di-quote (highlight)
  createdAt  DateTime @default(now())

  @@index([sessionId])
}

model DesignerPage {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  name      String   @default("Page 1")
  html      String
  versions  Json?    // array [{ id, html, updatedAt }] — history buat revert
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sessionId])
}
